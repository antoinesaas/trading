# =============================================================================
# Bot de trading — PAPER TRADING UNIQUEMENT
# Copier en .env (ou `python -m app init-env` qui génère les secrets).
# Ne JAMAIS ajouter de clé d'exchange, de clé privée ou de seed phrase :
# le bot refuse de démarrer s'il en détecte.
# =============================================================================

# --- Sécurité (PAPER_ONLY=false ou TRADING_MODE!=paper => refus de démarrer) ---
PAPER_ONLY=true
TRADING_MODE=paper
WEBHOOK_SECRET=change_me
DASHBOARD_TOKEN=change_me

# --- Claude : décisions de trading ---
# DECISION_MODE=ai : Claude décide (entrées, stops, objectifs, % de risque) sous le contrôle
# des limites ci-dessous. DECISION_MODE=rules : règles du scanner uniquement.
ANTHROPIC_API_KEY=
DECISION_MODE=ai
AI_DECISION_MODEL=claude-opus-5-5
AI_DECISION_EFFORT=medium
AI_REVIEW_MODEL=claude-sonnet-5
AI_BRIEFING_MODEL=claude-sonnet-5
AI_BRIEFING_INTERVAL_MINUTES=240
AI_BRIEFING_MAX_SEARCHES=5
AI_MIN_CONFIDENCE=0.65
AI_MIN_SCAN_SCORE=50
# Nombre maximal de marchés analysés par Claude à chaque cycle (les meilleurs scores d'abord)
AI_MAX_ANALYSES_PER_CYCLE=2
AI_REVIEW_INTERVAL_MINUTES=120
AI_DAILY_BUDGET_USD=5
AI_MAX_CALLS_PER_HOUR=20
NEWS_BLACKOUT_MINUTES=30

# --- Capital (modifiable ensuite depuis le dashboard, bouton « Capital ») ---
INITIAL_CAPITAL=10000
# Devise du compte : les positions en EUR ou JPY sont converties au taux de change réel
ACCOUNT_CURRENCY=USD

# --- Limites de risque (codées, jamais contournables par l'IA) ---
RISK_PER_TRADE=0.01
HARD_MAX_RISK_PER_TRADE=0.02
MIN_RISK_PER_TRADE=0.0025
MAX_OPEN_POSITIONS=5
MAX_PORTFOLIO_RISK=0.05
MAX_CORRELATED_RISK=0.03
MAX_DAILY_LOSS=0.03
MAX_WEEKLY_LOSS=0.06
MAX_DRAWDOWN=0.10
CLOSE_POSITIONS_ON_MAX_DRAWDOWN=true
MAX_CONSECUTIVE_LOSSES=4
COOLDOWN_HOURS=6
MIN_REWARD_RISK=1.5
MIN_STOP_ATR=0.5
MAX_STOP_ATR=6
KELLY_MULTIPLIER=0.25
KELLY_MIN_TRADES=20
MAX_POSITION_PCT=1.0
MAX_SPREAD_PCT=0.002
# Coûts par défaut : les frais, slippage et tailles minimales réels de chaque marché
# (crypto, actions, ETF, forex) sont définis dans app/market/universe.py
SLIPPAGE=0.0005
TRADING_FEES=0.001
MIN_QTY=0.0001
QTY_STEP=0.0001
MIN_NOTIONAL=10

# --- Heures de trading (UTC) ---
# Les horaires de chaque bourse (NYSE, Euronext, forex, crypto 24/7) sont toujours respectés.
TRADE_WEEKENDS=true
# Heures exclues, ex. "22-23,0" (vide = toutes les heures autorisées)
NO_TRADE_HOURS_UTC=

# --- Sorties par défaut (mode règles et backtests ; Claude fixe les siennes) ---
STOP_LOSS_ATR_MULTIPLIER=2
TAKE_PROFIT_RISK_REWARD=2
TRAILING_STOP_ENABLED=false
TRAILING_STOP_ATR_MULTIPLIER=2
TRAILING_ACTIVATION_R=1
PARTIAL_TAKE_PROFIT_R=0
PARTIAL_TAKE_PROFIT_FRACTION=0.5
BREAKEVEN_AT_R=0
TIME_STOP_BARS=0

# --- Scanner (pré-filtre des opportunités) : confluence ou ema_rsi ---
STRATEGY=confluence
EMA_FAST=20
EMA_SLOW=50
RSI_LENGTH=14
RSI_LONG_THRESHOLD=50
RSI_SHORT_THRESHOLD=50
ATR_LENGTH=14

# --- Marché ---
# Crypto (Binance), actions US, ETF (S&P 500, Nasdaq, CAC 40) et forex (Yahoo Finance)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,NVDA,TSLA,NFLX,AAPL,MSFT,SPY,QQQ,CAC40,EURUSD,GBPUSD,USDJPY
TIMEFRAME=1h
CONTEXT_TIMEFRAMES=1h,4h,1d,1w
# live = Binance (crypto) + Yahoo Finance (actions, ETF, forex, indices), sans clé ;
# binance = crypto uniquement ; csv = fichiers data/{SYMBOL}_{TIMEFRAME}.csv
MARKET_DATA_PROVIDER=live
BINANCE_BASE_URL=https://data-api.binance.vision
YAHOO_BASE_URL=https://query1.finance.yahoo.com
BINANCE_FUTURES_URL=https://fapi.binance.com
FEAR_GREED_URL=https://api.alternative.me
CSV_DATA_DIR=data
POLL_INTERVAL_SECONDS=10
LOOKBACK_BARS=300
# internal = scanner du bot ; tradingview = alertes webhook ; both = les deux
SIGNAL_SOURCE=internal
BOT_AUTO_START=false

# --- Webhook TradingView ---
WEBHOOK_MAX_SIGNAL_AGE_SECONDS=120
WEBHOOK_MAX_FUTURE_SKEW_SECONDS=30
WEBHOOK_MAX_PRICE_DEVIATION=0.02
WEBHOOK_RATE_LIMIT_PER_MINUTE=30
TRADINGVIEW_IP_ALLOWLIST=

# --- Base de données ---
# SQLite par défaut. Supabase (projet trading) — remplacez MOT_DE_PASSE :
# DATABASE_URL=postgresql://postgres.kyfpiltdbfnhbxzdqocl:MOT_DE_PASSE@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///data/trading_bot.db

# --- Serveur et logs ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs
REPORTS_DIR=reports

# --- Optimiseur de paramètres du scanner (Claude + backtest walk-forward) ---
AI_OPTIMIZER_ENABLED=true
AI_OPTIMIZER_SYMBOLS=BTCUSDT,ETHUSDT,SPY,QQQ,NVDA,EURUSD
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
AI_OPTIMIZER_INTERVAL_HOURS=24
AI_AUTO_APPLY=true
AI_CANDIDATES=3
AI_TRAIN_BARS=1500
AI_VALIDATION_BARS=500
AI_MIN_TRADES=8
AI_MIN_IMPROVEMENT=0.5
