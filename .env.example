# =============================================================================
# Bot de trading — PAPER TRADING UNIQUEMENT
# Copier en .env (ou `python -m app init-env` qui génère les secrets).
# Ne JAMAIS ajouter de clé d'exchange, de clé privée ou de seed phrase :
# le bot refuse de démarrer s'il en détecte.
# =============================================================================

# --- Sécurité (PAPER_ONLY=false ou TRADING_MODE!=paper => refus de démarrer) ---
PAPER_ONLY=true
TRADING_MODE=paper
WEBHOOK_SECRET=change_me
DASHBOARD_TOKEN=change_me

# --- Capital et risque ---
INITIAL_CAPITAL=10000
ACCOUNT_CURRENCY=USDT
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
MAX_POSITION_PCT=1.0
CLOSE_POSITIONS_ON_MAX_DRAWDOWN=true
SLIPPAGE=0.0005
TRADING_FEES=0.001
MIN_QTY=0.0001
QTY_STEP=0.0001
MIN_NOTIONAL=10

# --- Sorties (valeurs initiales ; l'optimiseur IA peut les ajuster) ---
STOP_LOSS_ATR_MULTIPLIER=2
TAKE_PROFIT_RISK_REWARD=2
TRAILING_STOP_ENABLED=false
TRAILING_STOP_ATR_MULTIPLIER=2
TRAILING_ACTIVATION_R=1

# --- Stratégie EMA/RSI (valeurs initiales) ---
EMA_FAST=20
EMA_SLOW=50
RSI_LENGTH=14
RSI_LONG_THRESHOLD=50
RSI_SHORT_THRESHOLD=50
ATR_LENGTH=14

# --- Marché ---
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAME=15m
# binance = API publique de données Binance (sans clé) ; csv = fichiers data/{SYMBOL}_{TIMEFRAME}.csv
MARKET_DATA_PROVIDER=binance
BINANCE_BASE_URL=https://data-api.binance.vision
CSV_DATA_DIR=data
POLL_INTERVAL_SECONDS=5
LOOKBACK_BARS=300
# internal = signaux calculés par le bot ; tradingview = signaux reçus par webhook ; both = les deux
SIGNAL_SOURCE=internal
BOT_AUTO_START=false

# --- Webhook TradingView ---
WEBHOOK_MAX_SIGNAL_AGE_SECONDS=120
WEBHOOK_MAX_FUTURE_SKEW_SECONDS=30
WEBHOOK_MAX_PRICE_DEVIATION=0.02
WEBHOOK_RATE_LIMIT_PER_MINUTE=30
# Optionnel, séparé par des virgules (IP de TradingView publiées dans leur documentation)
TRADINGVIEW_IP_ALLOWLIST=

# --- Base de données ---
# SQLite par défaut. Supabase : postgresql://postgres.<ref>:<mot_de_passe>@<pooler>.supabase.com:5432/postgres
DATABASE_URL=sqlite:///data/trading_bot.db

# --- Serveur et logs ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs
REPORTS_DIR=reports

# --- Optimiseur IA (Claude Opus 5.5) ---
ANTHROPIC_API_KEY=
AI_OPTIMIZER_ENABLED=false
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
AI_OPTIMIZER_INTERVAL_HOURS=24
AI_AUTO_APPLY=true
AI_CANDIDATES=3
AI_TRAIN_BARS=1500
AI_VALIDATION_BARS=500
AI_MIN_TRADES=8
AI_MIN_IMPROVEMENT=0.5
